{
  "id": "multi-agent-contract-protocol",
  "name": "Multi-Agent Contract Protocol",
  "description": "A memory-backed contract protocol for reliable multi-agent collaboration.",
  "version": "0.1.0",
  "activation": { "onStartup": true },
  "contracts": {
    "tools": ["multiagent_memory_record", "multiagent_memory_inspect", "multiagent_contract_transition"]
  },
  "skills": ["skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "storeRoot": { "type": "string", "description": "Directory containing the three memory banks." },
      "autoInitialize": { "type": "boolean", "default": true, "description": "Ask the root coordinator to derive task-local memory before its first child spawn." },
      "dependencyEnabled": { "type": "boolean", "default": true },
      "codomainEnabled": { "type": "boolean", "default": true },
      "testingEnabled": { "type": "boolean", "default": true },
      "maxItemsPerMemory": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 },
      "maxRecoveryAttempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 }
    }
  }
}
